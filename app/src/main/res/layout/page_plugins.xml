<?xml version="1.0" encoding="utf-8"?>
<!-- 插件页（在主页左边）：标题 + 说明 + 安装入口（下移并放大的两个大按钮）+ 插件列表（代码动态填充） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 标题行：只留标题与"安装示例"（次要操作，保持小尺寸，不跟主操作抢位置） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_plugins"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                style="@style/Widget.WhalePet.Button"
                android:id="@+id/btn_plugin_sample"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plugin_install_sample" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="@string/plugins_page_hint"
            android:textSize="12sp" />

        <!-- 安装入口：从标题行下移到这里，两个等宽大按钮（等宽 + 48dp 高，比较好按、字也看得清） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                style="@style/Widget.WhalePet.Button.Primary"
                android:id="@+id/btn_plugin_install"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/plugin_install" />

            <Button
                style="@style/Widget.WhalePet.Button"
                android:id="@+id/btn_plugin_import"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/plugin_import_from_file" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_plugins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>

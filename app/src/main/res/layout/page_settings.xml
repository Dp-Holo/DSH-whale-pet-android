<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
            android:paddingBottom="88dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="@string/settings_perm_hint"
            android:textSize="12sp" />

        <!-- 悬浮窗权限（已授予隐藏） -->
        <Button
                style="@style/Widget.WhalePet.Button.Primary"
            android:id="@+id/btn_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/grant_overlay" />

        <!-- 电池优化白名单（已加入隐藏），与上一按钮相邻 -->
        <Button
                style="@style/Widget.WhalePet.Button"
            android:id="@+id/btn_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/battery_whitelist" />

        <!-- 通知设置 -->
        <Button
                style="@style/Widget.WhalePet.Button"
            android:id="@+id/btn_notif_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/notif_settings" />

        <!-- 关于鲸鱼娘桌宠（技术说明 + GitHub 链接） -->
        <Button
                style="@style/Widget.WhalePet.Button"
            android:id="@+id/btn_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/about_entry" />

        <!-- 标题：左下角 -->
    </LinearLayout>
    </ScrollView>

    <!-- 标题：固定左下角（不随内容滚动） -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="28dp"
        android:layout_marginStart="24dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/settings_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />
</FrameLayout>


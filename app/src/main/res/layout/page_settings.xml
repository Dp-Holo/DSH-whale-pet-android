<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页。
     拇指区原则：说明文字在上方；五个入口全部收进底部操作区（两列排布），
     单手右手可及，不再从页面顶部往下排。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="250dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:text="@string/settings_perm_hint"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- 底部操作区：标题 + 五个入口（右侧留出 FAB 的位置） -->
    <LinearLayout
        android:id="@+id/settings_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/surface_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="68dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 第一行：悬浮窗权限（已授予隐藏） + 电池优化白名单 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                style="@style/Widget.WhalePet.Button.Primary"
                android:id="@+id/btn_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="124dp"
                android:text="@string/grant_overlay" />

            <Button
                style="@style/Widget.WhalePet.Button"
                android:id="@+id/btn_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="124dp"
                android:text="@string/battery_whitelist" />
        </LinearLayout>

        <!-- 第二行：通知设置 + 动态壁纸入口 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                style="@style/Widget.WhalePet.Button"
                android:id="@+id/btn_notif_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="124dp"
                android:text="@string/notif_settings" />

            <Button
                style="@style/Widget.WhalePet.Button"
                android:id="@+id/btn_wallpaper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="124dp"
                android:text="@string/wallpaper_entry" />
        </LinearLayout>

        <!-- 第三行：关于 -->
        <Button
            style="@style/Widget.WhalePet.Button"
            android:id="@+id/btn_about"
            android:layout_gravity="end"
            android:layout_width="wrap_content"
            android:minWidth="124dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/about_entry" />
    </LinearLayout>
</FrameLayout>

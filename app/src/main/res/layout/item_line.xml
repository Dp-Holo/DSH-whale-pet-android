<?xml version="1.0" encoding="utf-8"?>
<!-- 台词条目：上方文字，右下角「编辑 / 删除」两个图标按钮（无描边圈，中间用斜杠分隔） -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/line_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <!-- 编辑：无背景圈、点按区域 44dp、图标 26dp（放大且与删除视觉一致） -->
            <ImageButton
                android:id="@+id/btn_edit_line"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@null"
                android:contentDescription="@string/edit_line_hint"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_edit_line" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:alpha="0.45"
                android:text="/"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_del_line"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@null"
                android:contentDescription="@string/delete_line_title"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_delete_line" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<!-- 外壳：内容区 + 右下角菜单按钮 + 右侧抽屉菜单（替代原来的底部 tab）。
     层级说明：FAB 放在 DrawerLayout 之外的最上层，抽屉打开时按钮仍然可见可点。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 内容区：四页切换（插件 / 主页 / 台词 / 设置） -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include
                android:id="@+id/page_plugins"
                layout="@layout/page_plugins"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <include
                android:id="@+id/page_home"
                layout="@layout/page_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/page_lines"
                layout="@layout/page_lines"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <include
                android:id="@+id/page_settings"
                layout="@layout/page_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 右侧抽屉菜单：设置在最顶部，插件/台词管理/主页集中在底部 1/3（手指可及） -->
        <LinearLayout
            android:id="@+id/menu_panel"
            android:layout_width="192dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@color/menu_bg"
            android:orientation="vertical"
            android:paddingBottom="96dp"
            android:paddingTop="12dp">

            <!-- 设置：单独留在顶部 -->
            <FrameLayout
                android:id="@+id/menu_settings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@android:color/transparent">

                <View
                    android:id="@+id/ind_settings"
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/brand_primary"
                    android:visibility="invisible" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp"
                    android:text="@string/tab_settings"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </FrameLayout>

            <!-- 中间留白，把下面三项压到底部 -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 插件 -->
            <FrameLayout
                android:id="@+id/menu_plugins"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@android:color/transparent">

                <View
                    android:id="@+id/ind_plugins"
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/brand_primary"
                    android:visibility="invisible" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp"
                    android:text="@string/tab_plugins"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </FrameLayout>

            <!-- 台词管理 -->
            <FrameLayout
                android:id="@+id/menu_lines"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@android:color/transparent">

                <View
                    android:id="@+id/ind_lines"
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/brand_primary"
                    android:visibility="invisible" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp"
                    android:text="@string/tab_lines"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </FrameLayout>

            <!-- 主页（最底部） -->
            <FrameLayout
                android:id="@+id/menu_home"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@android:color/transparent">

                <View
                    android:id="@+id/ind_home"
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/brand_primary"
                    android:visibility="invisible" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp"
                    android:text="@string/tab_home"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </FrameLayout>
        </LinearLayout>
    </androidx.drawerlayout.widget.DrawerLayout>

    <!-- 右下角菜单按钮：蓝底三横线；打开抽屉时变浅底 + 蓝叉 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/tab_home"
        android:src="@drawable/ic_menu_lines"
        android:stateListAnimator="@null"
        app:backgroundTint="@color/brand_primary"
        app:borderWidth="0dp"
        app:elevation="4dp"
        app:fabSize="mini"
        app:rippleColor="@android:color/transparent"
        app:shapeAppearanceOverlay="@style/WhalePetFabCircle"
        app:tint="@color/f2f4f5" />
</FrameLayout>

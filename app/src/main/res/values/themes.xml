<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Material 3 主题：
      - Android 12+（API 31+）：WhalePetApp 中 DynamicColors.applyToActivitiesIfAvailable
        自动从壁纸提取主题色（Monet）
      - 低版本：回退下方鲸鱼娘主题色
    -->
    <style name="Theme.WhalePet" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 低版本 fallback 色（壁纸取色不可用时使用） -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#DDE3FF</item>
        <item name="colorOnPrimaryContainer">#10214A</item>
        <item name="colorSecondary">#2E9E5B</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="android:windowBackground">@color/surface_page</item>
        <item name="colorSurfaceVariant">#EDEDED</item>
        <item name="colorOutline">@color/outline_soft</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!--
      全应用**唯一**的按钮样式：主页 / 设置 / 台词管理 / 插件 四个页面共用。

      为什么收敛成一种：此前主页与设置用 Material 默认实心按钮（跟着 system 尺寸走），
      台词与插件页各自写 style="?attr/materialButtonOutlinedStyle" 再手工调
      minHeight/textSize/inset，尺寸与观感两套并存、后续页面还会继续漂移。
      统一到这里以后，新页面只写 style="@style/Widget.WhalePet.Button"，
      间距与尺寸由样式负责，布局里只留 layout_* 布局属性。
    -->
    <style name="Widget.WhalePet.Button" parent="Widget.Material3.Button.TonalButton">
        <!-- 次要操作：淡灰填充 + 圆角。文字按钮太"隐形"，用户看不出哪些地方能点，
             因此改为有底色的 chip 形态；主次仍靠颜色区分。布局里不要再手工调尺寸。 -->
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">@color/surface_chip</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.WhalePet.Button.Primary" parent="Widget.Material3.Button.TonalButton">
        <!-- 主操作：柔和填充，区别于次要的文字按钮 -->
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textSize">13sp</item>
    </style>

</resources>

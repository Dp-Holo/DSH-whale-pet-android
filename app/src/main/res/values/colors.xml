<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 语义色：界面只引用这些名字，不再在各布局里硬编码十六进制。
         灰阶一律用中性灰（R=G=B），避免与蓝色主色相邻时被感知成"灰粉"。 -->

    <color name="ic_launcher_background">#3A5FD6</color>
    <!-- 主品牌色（主题 colorPrimary 也指向它，布局/代码统一引用这个资源） -->
    <color name="brand_primary">#4D6BFE</color>

    <!-- 文字层级（中性灰阶） -->
    <color name="text_primary">#4D6BFE</color>
    <color name="text_secondary">#4D6BFE</color>
    <color name="text_hint">#4D6BFE</color>

    <!-- 余额与金额提示 -->
    <color name="balance_main">#5B6BFE</color>
    <color name="balance_shadow">#C8C8C8</color>
    <color name="delta_loss">#E5484D</color>
    <color name="delta_gain">#2E9E5B</color>

    <!-- 卡片与表面：页面浅灰、卡片纯白，靠明度差形成层次 -->
    <color name="surface_page">#F7FAFF</color>
    <color name="surface_card">#FFFFFF</color>
    <color name="surface_chip">#E8E8E8</color>
    <color name="outline_soft">#DEDEDE</color>

    <!-- 菜单（抽屉）：背景浅灰、选中项背景浅蓝（按用户提供图片取色 #EFF3FF） -->
    <color name="menu_bg">#F7FAFF</color>
    <color name="menu_selected">#EFF3FF</color>
    <color name="f2f4f5">#F2F4F5</color>
</resources>
